{
  "appId": "au.acedit.app",
  "appName": "AcedIt",
  "webDir": "dist",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#58CC02",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#58CC02"
    },
    "Keyboard": {
      "resize": "native"
    }
  },
  "ios": {
    "contentInset": "always"
  }
}
